# Copia este archivo a `.env` y rellena tus secretos.
# `.env` está en .gitignore: nunca se sube a git.
#
# Alice carga `.env` al arrancar. Las variables reales del entorno tienen
# prioridad sobre lo que pongas aquí.

# --- API key del LLM (OpenAI) ---
# Consíguela en https://platform.openai.com/api-keys
# OJO: la suscripción de ChatGPT es aparte; la API se paga por uso (tokens).
ALICE_LLM__API_KEY=sk-pega-tu-clave-aqui

# --- Otros overrides opcionales (mismo formato ALICE_<SECCION>__<CAMPO>) ---
# ALICE_LLM__MODEL=gpt-4o-mini
# ALICE_LLM__BASE_URL=https://api.openai.com/v1
